{
  "description": "Periodically fetch XMCO Yuno tickets and push them to a Sekoia intake",
  "docker_parameters": "xmco_yuno_ticket",
  "name": "Fetch XMCO Yuno Tickets",
  "arguments": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "XMCO Yuno Ticket Connector Configuration",
    "type": "object",
    "properties": {
      "intake_key": {
        "description": "Intake key to use when sending events",
        "type": "string"
      },
      "intake_server": {
        "description": "Server of the intake server (e.g. 'https://intake.sekoia.io')",
        "default": "https://intake.sekoia.io",
        "type": "string"
      },
      "frequency": {
        "type": "integer",
        "description": "Pull interval in seconds",
        "default": 3600
      },
      "start_date": {
        "type": "string",
        "description": "Initial start date (RFC2822) for first run. Example: 'Mon, 01 Jan 2024 00:00:00 GMT'. Defaults to 30 days ago if not set."
      }
    },
    "required": [
      "intake_key"
    ]
  },
  "uuid": "b2c3d4e5-f6a7-8901-bcde-f12345678902"
}
